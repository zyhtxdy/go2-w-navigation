# colcon outputs: keep local builds, do not publish them.
/build/
/install/
/log/

# Field recordings and site-specific maps stay on this machine.
/bags/
/maps/
/validation/
/tmp/

# Local editor, Python and test caches.
/.vscode/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/
*.swp
*.swo
*~
.DS_Store

# Generated binaries and recordings; small source test fixtures remain tracked.
*.o
*.a
*.so
*.so.*
*.mcap
*.db3
*.db3-shm
*.db3-wal
*.pcap
*.pcapng
*.log
core
core.[0-9]*

# FAST-LIO runtime output. Keep its upstream analysis helpers.
/src/FAST_LIO_ROS2/PCD/
/src/FAST_LIO_ROS2/Log/*.txt
/src/FAST_LIO_ROS2/Log/*.csv
/src/FAST_LIO_ROS2/Log/*.png
/src/FAST_LIO_ROS2/Log/*.pdf

# Historical verification records are archived outside the repository.
/docs/validation/

# Optional local credentials/configuration should not enter source control.
.env
.env.*
!.env.example
*.pem
*.key
